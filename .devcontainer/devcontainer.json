{
    "name": "ERNI Rust Dev Container",
    "image": "mcr.microsoft.com/devcontainers/rust:latest",
    // move cargo target folder into container to speed up builds
    "containerEnv": {
        "CARGO_TARGET_DIR": "/tmp/cargo-target"
    },
    "runArgs": ["--userns=keep-id"],
    "customizations": {
        "vscode": {
            "settings": {
                // do not scroll beyond last line because it could confuse beginners
                "editor.scrollBeyondLastLine": false,
                // automatically save after 1 second
                "editor.formatOnSave": true,
                "files.autoSave": "afterDelay",
                // scale the minimap to the window height
                "editor.minimap.size": "fill",
                // do not show the right sidebar because we need the screen space for a two column editor layout
                "workbench.secondarySideBar.defaultVisibility": "hidden",
                "chat.disableAIFeatures": true,
                "workbench.auxiliaryBar.visible": false,
                // Keep rust-analyzer snappy by using a separate target dir inside the cargo target dir
                "rust-analyzer.cargo.targetDir": true,
                // adjust explorer view to show tasks
                "explorer.openEditors.visible": 1,
                "outline.collapseItems": "alwaysCollapse",
                "timeline.excludeSources": [
                    "git-history"
                ],
                // Keep Cargo.toml dependencies on one line
                "evenBetterToml.formatter.inlineTableExpand": false,
                "evenBetterToml.formatter.arrayAutoExpand": false,
                "evenBetterToml.formatter.arrayAutoCollapse": true,
                "evenBetterToml.formatter.columnWidth": 10000,
                // open readme on startup and use markdown preview for it
                "workbench.startupEditor": "readme",
                "workbench.editorAssociations": {
                    "README.md": "vscode.markdown.preview.editor"
                }
            },
            "extensions": [
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml",
                "fill-labs.dependi",
                "vadimcn.vscode-lldb",
                "usernamehw.errorlens",
                "microhobby.taskrunnercodeplus",
                "DavidAnson.vscode-markdownlint",
                "MS-vsliveshare.vsliveshare"
            ]
        }
    },
    // Forwarded ports can be defined and labelled here
    // "forwardPorts": [
    //     3000
    // ],
    // "portsAttributes": {
    //     "3000": {
    //         "label": "View Book",
    //         "onAutoForward": "ignore"
    //     }
    // },
    "updateContentCommand": "chmod +x .devcontainer/update_content.sh && .devcontainer/update_content.sh",
    "postCreateCommand": "chmod +x .devcontainer/post_create.sh && .devcontainer/post_create.sh"
}